# The script `octachrome sim` plays when no --script is given: the whole control
# surface in 7 seconds (steps, inspector, brain, punch-in, strip, macro).

0.1  btn play
1.0  btn group b            # bass track
1.0  touch 5 on
1.0  knob 5 150             # more FM index
1.9  touch 5 off
1.9  shot 1-step
1.9  pad 14 strike 0.7      # step 3 (top row, has a ratchet): holding opens the inspector
2.4  shot 2-inspector
2.4  pad 14 release
3.0  btn chords
3.2  pad 3 strike 0.9       # live IV chord
3.8  shot 3-brain
3.8  pad 3 release
3.8  btn perform
3.8  btn group a
4.0  pad 0 strike 0.4       # LPF
4.2  pad 0 pressure 0.5
4.4  pad 0 pressure 0.8
4.6  pad 0 pressure 0.95
4.8  shot 4-punch
4.8  pad 0 release
4.8  pad 10 strike 1.0      # repeat 1/16
5.4  pad 10 release
5.4  btn step
5.4  strip 0.25
6.0  strip off
6.0  btn group d            # macro track
6.0  knob 6 60              # brighter timbre
6.8  shot 6-macro
