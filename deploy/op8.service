# /etc/systemd/system/op8.service
# Boots straight into OP-8: no desktop, restarts on crash or unplug.
[Unit]
Description=OP-8 groovebox (Maschine MK3)
After=sound.target systemd-udev-settle.service
Wants=systemd-udev-settle.service

[Service]
Type=simple
User=op8
Group=audio
SupplementaryGroups=plugdev
ExecStart=/usr/local/bin/op8 run
Restart=always
RestartSec=1
# Low-latency audio: 64-frame buffer at 48 kHz = 1.3 ms per block.
Environment=OP8_BUFFER=64
Environment=OP8_AUDIO_DEVICE=Maschine
# Allow real-time scheduling for the audio thread and locked memory.
LimitRTPRIO=95
LimitMEMLOCK=infinity
Nice=-10
# Keep OP-8 off the core the kernel uses most (see README: isolcpus).
CPUAffinity=1-3

[Install]
WantedBy=multi-user.target
